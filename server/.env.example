# Copy to server/.env, which is ignored by Git. Never put keys in dist/.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TELEGRAM_BOT_TOKEN=
# A second bot token for recipient-facing examples, never the assistant token.
TELEGRAM_DEMO_BOT_TOKEN=
# Your numeric Telegram user ID; only this owner's private chats can use either bot.
TELEGRAM_ALLOWED_USER_ID=
# Set true only for dedicated Roots identities; shared Padel bots are refused.
ROOTS_TELEGRAM_DEDICATED=false
ROOTS_TELEGRAM_DEMO_DEDICATED=false
