# Copy to server/.env, which is ignored by Git. Never put keys in dist/.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID; only this private chat can use the bot.
TELEGRAM_ALLOWED_USER_ID=
# Set true only for a separate Roots bot; shared Padel bot identities are refused.
ROOTS_TELEGRAM_DEDICATED=false
