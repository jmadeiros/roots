      "refersTo": "button-primary",
      "description": "A committed action with forest emphasis.",
      "html": "<div class=\"ds-preview\"><button class=\"ds-button ds-primary\">Explore partnership <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-5-5 5 5-5 5\"/></svg></button></div>",
      "css": ".ds-preview{font-family:'DM Sans',sans-serif;font-size:14px;line-height:1.5;color:var(--ink,#23392f)}.ds-preview svg{width:20px;height:20px;display:block;flex-shrink:0}.ds-preview button,.ds-preview input{font:inherit;color:inherit;cursor:pointer}.ds-preview :is(button,a,input,select,textarea):focus-visible{outline:3px solid #587842;outline-offset:4px}.ds-preview a{text-decoration:none}.ds-preview h3,.ds-preview p{margin:0}.ds-preview button:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-preview *{animation:none!important;transition:none!important}}.ds-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:36px;border-radius:6px;padding:9px 13px;font-size:12px;font-weight:500;border:1px solid var(--line, #dfe5da);background:#fff;white-space:nowrap;transition:background .15s,box-shadow .15s}.ds-button:hover{background:#f0f4ea}.ds-button svg{width:14px;height:14px}.ds-button.ds-primary{background:var(--forest, #234c3c);border-color:var(--forest, #234c3c);color:#fff}.ds-button.ds-primary:hover{background:var(--deep, #193d30)}"
    },
